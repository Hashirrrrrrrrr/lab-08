    {
      "name": "8. GET fee for student BSCS-023",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Calculates fee for student\", function () {",
              "  const f = pm.response.json();",
              "  pm.expect(f.rollNumber).to.eql(\"BSCS-023\");",
              "  pm.expect(f.name).to.eql(\"Sara Ahmed\");",
              "  pm.expect(f.creditHours).to.eql(12);",
              "  pm.expect(f.ratePerCreditHour).to.eql(5000);",
              "  pm.expect(f.total).to.be.a(\"number\");",
              "});"
            ]
          }
        }
