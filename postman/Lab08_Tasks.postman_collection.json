    {
      "name": "4. POST create course (saves newCode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Course created, values cleaned, saves newCode\", function () {",
              "  const c = pm.response.json();",
              "  pm.expect(c.code).to.eql(\"CS-420\");",
              "  pm.expect(c.title).to.eql(\"Compilers\");",
              "  pm.expect(c.tags).to.eql([\"theory\", \"core\"]);",
              "  pm.collectionVariables.set(\"newCode\", c.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \" cs-420 \",\n  \"title\": \" Compilers \",\n  \"creditHours\": 3,\n  \"instructor\": \"Dr. Hamza Rauf\",\n  \"department\": \"Computer Science\",\n  \"tags\": [\n    \"Theory\",\n    \"CORE\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses"
          ]
        }
      }
    },
